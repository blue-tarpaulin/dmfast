// Test world for the DreamSeeker patch `particles`.
//   tiles     an emitter on every turf sharing one small set: the frame rate case (AMD: a few fps on stock)
//   dots      the same with dot particles (no icon)
//   mix       sets of different shapes (100x300, 300x100) side by side: the depth buffer stops being recreated
//   static    sets spawned all at once that never move or fade, for map captures (PrintWindow) with and without
//             the fix (particle positions are random per client: compare several captures)
//   fire      the particle set from forum post 2933097 on every turf, each its own set
//   overflow  one set of 12000 icon particles of one icon, all at once: stock writes 72000 indices into its
//             65536-index buffer; with the fix every particle is drawn
// Compare the frame rate (tiles, dots, mix, fire) and the captures (static, overflow) between the two installs.

world
	fps = 20
	icon_size = 32
	view = 12
	maxx = 25
	maxy = 25
	maxz = 1
	turf = /turf/floor
	mob = /mob/viewer

/turf/floor
	icon = 'turf.dmi'
	icon_state = "floor"

/mob/viewer
	icon = 'turf.dmi'
	icon_state = "box"
	Login()
		..()
		loc = locate(13, 13, 1)
		client.fps = 100
		client.perspective = EYE_PERSPECTIVE

/obj/emitter
	icon = 'turf.dmi'
	icon_state = "box"
	mouse_opacity = 0

/particles/tile
	width = 96
	height = 96
	count = 10
	spawning = 1.2
	fade = 4
	fadein = 2
	lifespan = generator("num", 6, 8, LINEAR_RAND)
	position = generator("box", list(-32,32,0), list(32,40,50))
	bound1 = list(-32, -32, -1000)
	bound2 = list(40, 40, 1000)
	gravity = list(0, -3)
	friction = 0.05
	drift = generator("sphere", 0, 1)
	icon = 'part.dmi'
	icon_state = "dot"

/particles/tile/dots
	icon = null
	icon_state = null
	color = "#80c0ff"

/particles/tall
	width = 100
	height = 300
	count = 60
	spawning = 6
	lifespan = 10
	icon = 'part.dmi'
	icon_state = "dot"
	position = generator("box", list(-40,-140,0), list(40,140,50))

/particles/wide
	parent_type = /particles/tall
	width = 300
	height = 100
	position = generator("box", list(-140,-40,0), list(140,40,50))

// Spawned all at once, never move or fade.
/particles/still
	width = 200
	height = 200
	count = 400
	spawning = 100000
	lifespan = 100000000
	icon = 'part.dmi'
	icon_state = "star"
	position = generator("box", list(-90,-90,-50), list(90,90,50))
	color = generator("color", "#ff4040", "#40ff40", UNIFORM_RAND)

/particles/still/dots
	icon = null
	icon_state = null
	color = generator("color", "#4040ff", "#ffff40", UNIFORM_RAND)

/particles/still/overflow
	width = 700
	height = 700
	count = 12000
	position = generator("box", list(-340,-340,-50), list(340,340,50))

/particles/fire
	icon = 'part.dmi'
	icon_state = "dot"
	width = 100
	height = 100
	count = 1000
	spawning = 8
	lifespan = 7
	fade = 10
	grow = -0.01
	velocity = list(0, 0)
	position = generator("box", list(-16, -16), list(16, 16), NORMAL_RAND)
	drift = generator("vector", list(0, -0.2), list(0, 0.2))
	gravity = list(0, 0.95)
	scale = generator("vector", list(0.3, 0.3), list(1, 1), NORMAL_RAND)
	rotation = 30
	spin = generator("num", -20, 20)

/world/New()
	..()
	var/mode = world.params["mode"] || "tiles"
	log << "particles mode=[mode]"
	switch(mode)
		if("tiles", "dots")
			var/particles/shared = mode == "tiles" ? new /particles/tile : new /particles/tile/dots
			for(var/turf/T in block(locate(1,1,1), locate(world.maxx, world.maxy, 1)))
				var/obj/emitter/E = new(T)
				E.icon = null
				E.particles = shared
		if("fire")
			for(var/turf/T in block(locate(1,1,1), locate(world.maxx, world.maxy, 1)))
				var/obj/emitter/E = new(T)
				E.icon = null
				E.particles = new /particles/fire
		if("mix")
			for(var/x = 3 to 23 step 4)
				for(var/y = 3 to 23 step 4)
					var/obj/emitter/E = new(locate(x, y, 1))
					E.particles = ((x + y) % 8) ? new /particles/tall : new /particles/wide
		if("static")
			var/obj/emitter/A = new(locate(9, 13, 1))
			A.particles = new /particles/still
			var/obj/emitter/B = new(locate(17, 13, 1))
			B.particles = new /particles/still/dots
		if("overflow")
			var/obj/emitter/E = new(locate(13, 13, 1))
			E.particles = new /particles/still/overflow
