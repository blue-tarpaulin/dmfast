// outputleak: an operator<< overload that outputs with ..() keeps a reference to its args on stock BYOND, so a /sound
// sent through it (usr << sound) is never freed. refcount() shows it; fixtest's memory runs (outputleak.leak) also send
// n and 2n sounds.
/mob/listener/proc/operator<<(x)
	return ..()

/sound/payload/var/list/data

/proc/leak(n)
	var/mob/listener/m = new
	for(var/i in 1 to n)
		var/sound/payload/S = new
		S.data = new /list(20)
		m << S

/proc/check()
	var/mob/listener/m = new
	var/sound/S = sound(null)
	var/datum/d = new
	var/list/L = list(1, 2)
	for(var/i in 1 to 3)
		m << S
		m << d
		m << L
	world.log << "sound: references [refcount(S)]"
	world.log << "datum: references [refcount(d)]"
	world.log << "list: references [refcount(L)]"
	m << "text"
	world.log << "text: ok"

/world/New()
	..()
	var/n = text2num(world.params["n"])
	if(n)
		leak(n)
	else
		check()
	shutdown()
