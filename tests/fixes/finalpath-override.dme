/a/final/bar()
/a/sub/bar()
/a/bar()

/c/final/proc/bar()
/c/sub/bar()

/d/proc/bar()
/d
	final
		bar()
	sub
		bar()

/e
	final/var/x = 6
/e/sub/x = 7
