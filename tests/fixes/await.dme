// await: await call_ext() no longer leaves its library name or load_ext() handle under its result (516.1688),
// leaks its last arg, or breaks a handle's second call (516.1689+). await-gen.sh builds the library.
#define LATER "byond,await:await_later"
#define NOW "byond,await:await_now"

var/lib

/proc/count(fn, handle)
	var/datum/a = new
	var/datum/b = new
	var/h = load_ext(lib, fn)
	var/before_a = refcount(a)
	var/before_b = refcount(b)
	for(var/i in 1 to 3)
		try
			if(handle)
				call_ext(h)(a, b)
			else
				call_ext(lib, fn)(a, b)
		catch(var/exception/e)
			return "call [i]: [e.name]"
	return "+[refcount(a) - before_a] +[refcount(b) - before_b]"

/proc/test()
	var/n = text2num(world.params["n"])
	if(n)
		for(var/i in 1 to n)
			call_ext(lib, NOW)(list(i))
	else
		for(var/fn in list(LATER, NOW))
			for(var/handle in 0 to 1)
				world.log << "[fn] by [handle ? "handle" : "name"]: [count(fn, handle)]"
		for(var/fn in list(LATER, NOW))
			world.log << "[fn] by name: [json_encode(list(7, 8, 9, call_ext(lib, fn)()))]"
			var/h = load_ext(lib, fn)
			world.log << "[fn] by handle: [json_encode(list(7, 8, 9, call_ext(h)()))]"
	shutdown()

/world/New()
	..
	lib = world.system_type == MS_WINDOWS ? "await.dll" : "./libawait.so"
	spawn(0)
		while(1)
			sleep(1)
	spawn(0)
		test()
