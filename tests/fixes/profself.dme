// Forum report 2913091: the profiler gives a proc that errors on entry a self CPU time far above its total: BYOND's clock
// reading at the error. By the recursion limit ("Maximum recursion level reached"): leaf() is the proc that errors (climb()
// calls it first at each level), loop() the report's own case (it calls itself). By wrong arguments: target() called
// with a bad argument name and with a positional argument after a named one. CPU burnt before the errors makes that
// reading large. Only comparisons are logged, so the output doesn't depend on timing: self <= total and overtime <= self.

/proc/burn(ds)
	set background = 1
	var/end = world.timeofday + ds
	var/n = 0
	while(world.timeofday < end)
		n++
	return n

/proc/leaf()
	return 1

/proc/climb()
	leaf()
	climb()

/proc/loop()
	loop()

/proc/target(a)
	return a

/proc/check(name)
	var/list/L = world.Profile(PROFILE_REFRESH)
	for(var/i = 7, i + 5 <= L.len, i += 6)
		if(L[i] == name)
			world.log << "[name]: calls>0=[L[i + 5] > 0] self<=total=[L[i + 1] <= L[i + 2]] over<=self=[L[i + 4] <= L[i + 1]]"
			return
	world.log << "[name]: not profiled"

/world/New()
	..()
	spawn(1)
		burn(5)
		world.Profile(PROFILE_RESTART)
		try
			climb()
		catch(var/exception/e1)
			world.log << "climb: [e1.name]"
		try
			loop()
		catch(var/exception/e2)
			world.log << "loop: [e2.name]"
		try
			target(b = 1)
		catch(var/exception/e3)
			world.log << "target: [e3.name]"
		try
			call(/proc/target)(a = 1, 2)
		catch(var/exception/e4)
			world.log << "target: [e4.name]"
		check("/proc/leaf")
		check("/proc/climb")
		check("/proc/loop")
		check("/proc/target")
		world.Profile(PROFILE_STOP)
		shutdown()
