// A weighted pick() whose last weight is a constant 0 crashes the world (forum report 2991804). Zero-weight entries must
// never be picked, wherever they are; other weights keep their stock behaviour. Constant weights are the
// encoding that failed, so every case uses literal weights. The broken jump target is the last kept option's
// threshold: 65535 minus the rounding loss, so 4 and 16 equal options (65532, 65520) are covered too.
/proc/show(label, value)
	world.log << "[label]: [value]"

/world/New()
	rand_seed(1234)
	var/r
	show("start", "ok")
	r = pick(1;"a", 0;"b")
	show("1;0", r)
	r = pick(1;"a", 1;"b", 0;"c")
	show("1;1;0 sample ok", r != "c")
	r = pick(5;"a", 0;"b", 0;"c")
	show("5;0;0", r)
	r = pick(0;"a", 1;"b")
	show("0;1", r)
	r = pick(1;"a", prob(0);"b")
	show("1;prob(0)", r)
	r = pick(1;pick(1;"a", 0;"b"), 0;"c")
	show("nested", r)
	var/list/seen = list()
	for(var/i in 1 to 400)
		seen[pick(1;"a", 1;"b", 0;"c")] = 1
	show("1;1;0 over 400", json_encode(sortList(seen)))
	seen = list()
	for(var/i in 1 to 400)
		seen[pick(0;"a", 1;"b", 1;"c", 0;"d")] = 1
	show("0;1;1;0 over 400", json_encode(sortList(seen)))
	seen = list()
	for(var/i in 1 to 400)
		seen[pick(1;"a", 1;"b", 1;"c", 0;"d")] = 1
	show("1;1;1;0 over 400", json_encode(sortList(seen)))
	seen = list()
	for(var/i in 1 to 400)
		seen[pick(1;"a", 1;"b", 1;"c", 1;"d", 0;"e")] = 1
	show("1;1;1;1;0 over 400", json_encode(sortList(seen)))
	seen = list()
	for(var/i in 1 to 1600)
		seen[pick(1;"a", 1;"b", 1;"c", 1;"d", 1;"e", 1;"f", 1;"g", 1;"h", 1;"i", 1;"j", 1;"k", 1;"l", 1;"m", 1;"n", 1;"o", 1;"p", 0;"z")] = 1
	show("16 x 1;0 over 1600", json_encode(sortList(seen)))
	var/a = 0
	var/b = 0
	for(var/i in 1 to 3000)
		if(pick(1;"a", 3;"b", 0;"c") == "b")
			b++
		else
			a++
	show("1;3;0 b is about 3x a", b > 2 * a && b < 4 * a)
	shutdown()

/proc/sortList(list/l)
	var/list/keys = list()
	for(var/k in l)
		keys += k
	for(var/i in 1 to keys.len)
		for(var/j in i + 1 to keys.len)
			if(keys[j] < keys[i])
				keys.Swap(i, j)
	return keys
