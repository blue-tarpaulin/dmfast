// Forum report 2968158: /world/Tick is not called until the second game tick (world.time 1). The extra call at 0 must
// see a sensible tick_usage, as a tick's own /world/Tick does.
/world/Tick()
	world.log << "Tick [world.time] usage<100=[world.tick_usage < 100]"

/world/New()
	world.log << "New [world.time]"
	..()
	spawn(0)
		world.log << "spawn0 [world.time]"
	spawn(1)
		world.log << "spawn1 [world.time]"
	spawn(3)
		world.log << "shutdown [world.time]"
		shutdown()
