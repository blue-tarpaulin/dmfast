// Forum report 2992603: with about 65,500 names, a child type's override of a var its parent sets at runtime is
// ignored for the vars whose names get string ids 0xFFCD-0xFFF1, which keep the parent's value. The padding and the
// 300 parent/child vars are generated by varoverride-gen.sh (see tools/fixtest.py).
#include "varoverride-pad.dm"
#include "varoverride-vars.dm"
#include "varoverride-check.dm"

/datum/parent/nulls/grandchild

/world/New()
	..()
	world.log << "parent: [check(new /datum/parent, list("parent"))] of 300"
	world.log << "null overrides: [check(new /datum/parent/nulls, null)] of 300"
	world.log << "null overrides, initial(): [check_initial(new /datum/parent/nulls, null)] of 300"
	world.log << "inherited null overrides: [check(new /datum/parent/nulls/grandchild, null)] of 300"
	world.log << "list overrides: [check(new /datum/parent/lists, list("child"))] of 300"
	shutdown()
