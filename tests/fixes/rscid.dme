// rscid: the 65,535th runtime resource must not get a resource id that another resource already has.
// "\ref" of a file from fcopy_rsc() carries its resource id (0xc000000 | id); stock BYOND moves the resource that
// would get id 0xFFFF to the main set and returns an id that is already taken.
#define N 70000
/world/New()
	..()
	var/list/seen = list()
	var/dups = 0
	var/first = 0
	var/nullid = 0
	for(var/i in 1 to N)
		var/icon/I = icon('rscid.dmi')
		I.DrawBox(rgb(i & 127, (i >> 7) & 127, (i >> 14) & 127), 1, 1, 32, 32)
		var/r = fcopy_rsc(I)
		var/k = "\ref[r]"
		if(k == "\[0xc00ffff\]") nullid++
		if(seen[k])
			dups++
			if(!first) first = i
		else
			seen[k] = i
	world.log << "distinct icons: [N]"
	world.log << "ids shared by two icons: [dups]"
	world.log << "first icon with a shared id: [first]"
	world.log << "icons given the null id: [nullid]"
	shutdown()
